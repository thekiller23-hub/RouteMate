# ========================================================
# RouteMate Environment Configuration Template
# Duplicate this file to .env and configure real credentials
# ========================================================

# Django Backend
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,api.routemate.com

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgresql://routemate_user:routemate_secure_password_2026@localhost:5432/routemate_db

# External Integrations: Google Maps API
# Used for geographical route matching, lat/lng geocoding, and distance matrices
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsAPIKeyHere

# External Integrations: Razorpay Payments & Escrow
# Sign up at https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# External Integrations: Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# SMS & OTP Service (Twilio / Fast2SMS / MSG91)
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key

# Email Notification Gateway
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@routemate.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True

